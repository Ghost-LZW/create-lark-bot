{
  "name": "create-lark-bot",
  "version": "0.2.1",
  "description": "Create a fully-configured Feishu/Lark bot app with one QR scan and your own name/description/avatar: Open Platform console creation + configuration (composable scope/event presets incl. VC meeting bot, callbacks, redirect URLs, version publish), official SDK device-flow fallback, existing-app update, and official-API verify. Extracted from botmux.",
  "type": "module",
  "license": "MIT",
  "author": "Ghost-LZW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghost-LZW/create-lark-bot.git"
  },
  "homepage": "https://github.com/Ghost-LZW/create-lark-bot#readme",
  "bugs": {
    "url": "https://github.com/Ghost-LZW/create-lark-bot/issues"
  },
  "bin": {
    "create-lark-bot": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test",
    "prepare": "tsc"
  },
  "keywords": [
    "bot",
    "device-flow",
    "feishu",
    "lark",
    "meeting-bot",
    "open-platform",
    "qrcode",
    "vc",
    "verify"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "qrcode-terminal": "^0.12.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
